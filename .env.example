# data_dog 环境变量示例 —— 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，绝不提交）
#
# 数据库连接串。留空 → 用本地 SQLite（零安装，适合开发/演示）。
# 连 PostgreSQL（compose 里的 db 服务）示例：
#   DD_DATABASE_URL=postgresql+psycopg://data_dog:data_dog_dev_pw@db:5432/data_dog
# 连本机 PostgreSQL 示例：
#   DD_DATABASE_URL=postgresql+psycopg://data_dog:data_dog_dev_pw@127.0.0.1:5432/data_dog
DD_DATABASE_URL=

# 服务监听
DD_SERVICE_HOST=0.0.0.0
DD_SERVICE_PORT=8000
DD_SERVICE_NAME=data-dog
DD_LOG_LEVEL=info

# 接入密钥。留空 = 不校验（只适合本机开发）。
# 一旦要给别人/对外访问，**必须**设置：生成一条强随机串填进来，然后告诉调用方放到 X-API-Key 头。
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
DD_API_KEY=

# 租户绑定密钥（可选，JSON）。配了就进入"租户绑定模式"：带 X-Tenant-Id 的请求必须
# 出示该租户绑定的密钥，否则 403。**单密钥模式下持密钥者可冒充任意租户**（见 README
# 诚实边界），对外多租户部署建议配上。
# DD_TENANT_KEYS={"tenant-a":"<key-a>","tenant-b":"<key-b>"}

# ---- Web 控制台（web/ 的 Next.js 服务端代理）用 ----
# 浏览器**不持有凭据**：控制台只请求同源 /api/dd/*，由服务端代理附加下面两项。
# 为什么不能放 NEXT_PUBLIC_*：Next.js 会把这类变量内联进客户端包，谁打开 devtools
# 都能读到，等于把一把可用密钥交给任何访问者。
# DD_WEB_API_BASE_URL=http://127.0.0.1:8000   # 上游服务地址（容器里用 http://app:8000）
# DD_WEB_API_KEY=                             # 与上面的 DD_API_KEY 一致
# DD_WEB_TENANT=tenant-demo                   # 强制注入的 X-Tenant-Id
# DD_WEB_BASIC_AUTH=ops:change-me             # 控制台自身的 Basic 口令（推荐对外时设置）
# DD_WEB_ALLOW_ANONYMOUS=1                    # 显式允许匿名（仅本机开发）

# compose 用的数据库账号（生产请改，并通过密钥管理注入）
POSTGRES_USER=data_dog
POSTGRES_PASSWORD=data_dog_dev_pw
POSTGRES_DB=data_dog
APP_PORT=8000

# ---- 对外部署（compose.prod.yaml）用 ----
# 你的域名，必须已把 A 记录解析到本机公网 IP。Caddy 会据此自动申请 HTTPS 证书。
DD_DOMAIN=
# 证书到期通知邮箱（可留空）
ACME_EMAIL=

# 大模型凭据（仅调查报告阶段需要；服务热路径不调用模型）
# DEEPSEEK_API_KEY=
