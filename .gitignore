# 环境变量与密钥 —— 绝不提交（示例模板例外，它不含真实密钥）
.env
.env.*
!.env.example

# Chroma 向量库本地数据（RAG）
.chroma/

# 本地数据库（SQLite）——运行时生成，不提交
*.db
*.db-journal
# WAL 模式的侧文件：SQLite 现在默认开 WAL（storage/db.py::_apply_sqlite_pragmas），
# 不加这两条，跑一次服务就会在工作区留下未跟踪的 *.db-wal / *.db-shm。
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 本地工具会话状态（非项目代码）
.mimosa/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
# 覆盖率产物（含 PG 腿单独产出的那份）
coverage*.json

# hypothesis 的性质测试缓存/失败案例库（本地生成，不提交）
.hypothesis/
.venv/
venv/

# 临时抓取 / 本地搜索残留（调研过程产物，不是项目文件）
.tmpsearch/
/t.html
/tri.html

# 接口调试响应残留（curl / 手测接口的产物，不是项目文件）
/a.json
/a2.json
/e.json
/ef.json
/ef2.json
/ef3.json
/fb.json
/fb2.json
/fb_body.json
/inv_out.json
/o.json
/r.json
/rf.json

# 本地工作记录 / 基线快照（过程产物，保留在本地即可）
.replica_baseline.txt
.replica_log.md

# Streamlit 本地运行缓存
.streamlit/secrets.toml

# 覆盖率产物（pytest --cov / make cov 生成）
.coverage
.coverage.*
htmlcov/
# 单模块门禁用到的 JSON 报告（scripts/cov_gate.py 读它；属生成物不入库）
coverage.json

# 本地 agent/编辑器工具配置（非项目代码）
.claude/

# P4-8 基准运行报告（每次跑的临时产物；结论沉淀进 benchmarks/baseline.md）
benchmarks/last_run.txt

# 本地生成的数据集（MuJoCo 仿真等）——体积大、可由 seed 重放，不入库
/data/

# 本地排障 / 取证用的临时文件（容器探测、现场快照、账本草稿）——不入库。
# 真正要留下的是结论：docs/ci-offline.md 与 artifacts/ci-offline 的回执。
/diag/
/*.bat
/.ledger_*.md
artifacts/
pip-audit.json

# 本机跑测的临时输出（不是证据，证据在 artifacts/ci-evidence/）
/pytest_run.log

# 本机构建日志
/build.log
/push2.log
