# 环境变量与密钥 —— 绝不提交（示例模板例外，它不含真实密钥）
.env
.env.*
!.env.example

# Chroma 向量库本地数据（RAG）
.chroma/

# 本地数据库（SQLite）——运行时生成，不提交
*.db
*.db-journal
*.sqlite
*.sqlite3

# 本地工具会话状态（非项目代码）
.mimosa/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/

# 临时抓取 / 本地搜索残留（调研过程产物，不是项目文件）
.tmpsearch/
/t.html
/tri.html

# 本地工作记录 / 基线快照（过程产物，保留在本地即可）
.replica_baseline.txt
.replica_log.md

# Streamlit 本地运行缓存
.streamlit/secrets.toml

# 覆盖率产物（pytest --cov / make cov 生成）
.coverage
.coverage.*
htmlcov/

# 本地 agent/编辑器工具配置（非项目代码）
.claude/
