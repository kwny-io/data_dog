#!/bin/sh
# data_dog pre-commit：只跑"快且能拦住大多数问题"的静态检查（亚秒级）。
# 两件事：ruff（只查暂存的 .py）+ README 规模数字核对（数的是 git 跟踪文件）。
# 全量门禁（ruff + mypy + 全量测试）放在 pre-push，避免每次提交都等几分钟。
#
# 启用：make hooks   （等价于 git config core.hooksPath scripts/git-hooks）
# 临时跳过：git commit --no-verify  （不建议：CI 会拦，只是把失败推后）
#
# 第三个检查是“这个提交里有没有私人文件/参赛材料”——它必须在这里，
# 不是在 pre-push：那时提交已经存在，amend 才能改，且很可能已经被别处引用。
set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# 解释器探测口径与 Makefile 一致：Linux/macOS 的 .venv/bin 与 Windows 的 .venv/Scripts
if [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then
    PY=.venv/Scripts/python.exe
else
    PY=python
fi

# 只检查本次暂存的 Python 文件（--diff-filter=ACM：新增/修改/复制的）
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' || true)
if [ -n "$files" ]; then
    count=$(printf '%s\n' "$files" | wc -l | tr -d ' ')
    echo "[pre-commit] ruff check（$count 个暂存文件）"
    printf '%s\n' "$files" | xargs "$PY" -m ruff check --force-exclude
fi

# README 的规模数字必须与**这个提交的索引**一致。
# 为什么放在这里、且**必须无条件跑**：readme_counts 数的是 git 跟踪的文件，于是"新增一个
# 测试文件"就会让 README 漂一位——而漂移不会自己报错，直到有人真的去数一遍。
# 漂移最常见的形态恰恰是**没有 .py 变更**的提交（只新增了文件、README 忘了改），
# 所以这一步不能挂在上面那个 if 块里面。（这个坑真踩过：脚本早就有了，但没人调用它。）
echo "[pre-commit] README 规模数字核对（scripts/readme_counts.py --check）"
"$PY" scripts/readme_counts.py --check

# 仓库是 public 的，且参赛/对外材料不进 feature 分支。
# 这两条以前只在 pre-push 的全量测试里生效——于是 `git add -A` 把私人文件或某个 PDF
# 踩进暂存区时，**提交已经落下了**，要等到推送才报。守卫的时机必须早于提交才叫守卫。
# 只跑这两个用例（亚秒级），但覆盖两个真事故模式：私人文档上传、参赛材料入仓。
echo "[pre-commit] 私人文件 / 参赛材料守卫（traced files）"
"$PY" -m pytest tests/test_project_meta.py -q \
    -k "no_private_paths_are_tracked or no_competition_materials_are_tracked" \
    --no-header -p no:cacheprovider

echo "[pre-commit] 通过"
