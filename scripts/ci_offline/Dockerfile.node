# CI 离线复现用镜像 2/2：Node 侧（对齐 ubuntu-latest + actions/setup-node 22）
# 前端两条 E2E 腿要真 Chromium；Playwright 的 --with-deps 会在容器里自己装系统库，
# 但需要 root + apt 可用（下面保留了 apt 索引所以能直接装）。
#
# 为何是 22 而不是 20：`@testing-library/jest-dom@6.10.0` 声明 `engines.node >= 22`，
# 在 20 上每轮都打 EBADENGINE 警告；GitHub 的 actions/setup-node 也已默认 22。
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# npm 在容器里直连公网，2026-10-23 实测 `ECONNRESET / network aborted` 把 web 腿打成 red。
# 那是网络而非代码，所以：重试 + 拔高超时，让瞬时断连不决定结论。
RUN npm config set fetch-retries 5 \
 && npm config set fetch-retry-maxtimeout 120000 \
 && npm config set fetch-timeout 300000

# 依赖预装（对齐 python 镜像的做法）：构建期跑一次 `npm ci`，腿内不再打公网。
# 理由不是“快”，而是**网络不该决定结论**：2026-10-24 实测 web 腿 428s 后死在
# `npm error code ECONNRESET / network aborted`，那是假红；而且构建期的失败是响的（构建就挂），
# 腿内的失败是静的（看上去像代码坏了）。
# 与工作树的对应关系：腿内依然用 git 文件集拷贝（含 package-lock.json），
# 依赖由镜像供给 —— 与 python 腿 `pip install -e . --no-deps` 完全同构。
WORKDIR /opt/web-deps
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# 浏览器目录必须**在安装之前**定下，否则 `npx playwright install` 会落到
# 默认的 /root/.cache/ms-playwright，而腿内的 PW_VOL 挂在 /ms-playwright ——
# 镜像里明明有浏览器，腿却报 “Executable doesn't exist”。
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Chromium 一并烘焙：``npx playwright install`` 会在腿内下载 → 又一个网络依赖。
# `--with-deps` 会 apt 装系统库，因此这一层只能在构建期做（镜像里本来就是 root）。
RUN npx playwright install --with-deps chromium

WORKDIR /work/web
# 同 Dockerfile.python：非 root 腿要能往工作目录里拷贝依赖（见那里的长注释）。
RUN chmod 1777 /work /work/web
